# ===========================================
# Coin Watch - Configuration
# ===========================================
# Copy this file to .env and fill in your values

# URL to monitor (default: Pinehurst Coins US Mint page)
TARGET_URL=https://usmint.pinehurstcoins.com/

# How often to check (cron expression)
# Default: every 5 minutes
CRON_SCHEDULE=*/5 * * * *

# Scraper mode: "browser" (Puppeteer) or "http" (Axios+Cheerio)
# Use "browser" if the site requires JavaScript rendering
# Use "http" for faster, lighter checks
SCRAPER_MODE=browser

# ===========================================
# Notification Settings
# ===========================================

# Comma-separated list of notification methods: console,email,telegram
NOTIFY_METHODS=console

# --- Email (SMTP) Notifications ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_TO=your-email@gmail.com
EMAIL_FROM=Coin Watch <your-email@gmail.com>

# --- Telegram Bot Notifications ---
# 1. Message @BotFather on Telegram, create a bot, copy the token
# 2. Message your bot, then visit https://api.telegram.org/bot<TOKEN>/getUpdates
#    to find your chat_id
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=your-chat-id

# ===========================================
# Browser Settings (Puppeteer)
# ===========================================

# Path to Chrome/Chromium executable (optional, auto-detected if blank)
CHROME_PATH=

# Run browser in headless mode (true/false)
HEADLESS=true

# Page load timeout in milliseconds
PAGE_TIMEOUT=30000
